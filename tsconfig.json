{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "strict": false,               
    "noImplicitAny": false,       
    "allowJs": true,               
    "checkJs": false,             
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist"]
}
